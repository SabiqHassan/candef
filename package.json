{
  "name": "candef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:demo && npm run typecheck && vite build",
    "preview": "vite preview --port 4190 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "review:gov-check": "tsx scripts/research/gov-row-check.ts",
    "check:gov-claims": "tsx pipeline/research/verify-gov-claims-cli.ts",
    "data:demo": "tsx pipeline/build-demo.ts && tsx pipeline/ingest/gov/ask/siteDataCli.ts --demo",
    "data:research": "tsx pipeline/build-research.ts && tsx pipeline/ingest/gov/ask/siteDataCli.ts",
    "data:rollback": "tsx pipeline/rollback.ts",
    "candef": "tsx pipeline/cli/candef.ts",
    "build:research": "npm run data:research && npm run typecheck && vite build --mode research",
    "release:beta": "tsx pipeline/release/beta.ts",
    "preview:local": "tsx pipeline/build-preview.ts && vite build --mode localpreview",
    "preview:mvp": "tsx pipeline/build-preview.ts --companies docs/verification/blind-v2-internal/cards.json && vite build --mode localpreview",
    "gov-api": "tsx pipeline/ingest/gov/api-cli.ts gov-api",
    "gov-triage": "tsx pipeline/ingest/gov/leads/triage.ts",
    "grant-search": "tsx pipeline/ingest/gov/search/cli.ts",
    "grant-ask": "tsx pipeline/ingest/gov/ask/cli.ts",
    "leads": "tsx pipeline/ingest/gov/ask/search/cli.ts",
    "preview:serve": "vite preview --mode localpreview --outDir .preview/site --port 4195",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "bench:renderer": "vite --config bench/renderer/vite.config.ts",
    "bench:renderer:build": "vite build --config bench/renderer/vite.config.ts",
    "test:perf": "npm run bench:renderer:build && playwright test -c tests/perf/playwright.config.ts",
    "stress:build": "tsx bench/stress/build.ts",
    "test:stress": "playwright test -c tests/stress/playwright.config.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "leads:data": "tsx pipeline/ingest/gov/ask/siteDataCli.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
